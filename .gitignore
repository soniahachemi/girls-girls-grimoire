# Matériel de direction artistique (design system source, exports Claude
# Design, moodboards de référence) : pas destiné à être publié avec le site.
# Hostinger déploie tout le dépôt tel quel (pas d'étape de build), donc rien
# ici ne doit être exposé publiquement. Source de vérité : canvas Claude
# Design (voir CLAUDE.md) + ce dossier en local.
design/

test-results/

# Mémos/debriefs des agents Ticcy (notes de travail internes, contexte de
# décisions) : pas destinés à être publiés avec le site, pour la même raison
# que design/ ci-dessus (Hostinger déploie tout le dépôt tel quel). Restent
# en local uniquement.
agents/

# Configuration VS Code locale (spécifique à la machine) — les modèles
# .example restent versionnés.
.vscode/
.vscode/*
!.vscode/*.example

# Dépendances Node (outillage de test, jamais commitées) — voir package.json
# et agents/guidelines.md (section Tests).
node_modules/

# Fichiers système
.DS_Store
Thumbs.db

# Fichiers de travail temporaires d'un agent (voir Ticcy/roles/common.md,
# section "Fichier temporaire") — jamais commités.
temp/

# Valeurs d'environnement locales (dev) — voir .env.example pour les noms de
# variables attendues, et agents/guidelines.md (Stack/Sécurité) pour le détail.
.env

# Fichier de config généré à partir de .env (dev, en local) ou des secrets
# GitHub Actions (prod, juste avant le déploiement) — voir scripts/generate-config.js
# et .github/workflows/deploy.yml. Le modèle committé est public/assets/config.example.js.
public/assets/config.js
